# === AFSONA DUB — production .env namunasi ===
# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring.
# .env hech qachon git'ga commit qilinmasin (.gitignore'da bo'lishi kerak).

# --- Telegram Bot ---
BOT_TOKEN=
# @ belgisiz, masalan: AfsonaDubBot — Mini App'dagi deep-link
# (t.me/<username>?start=task_<id>) shundan quriladi (GET /config orqali).
BOT_USERNAME=

# --- PostgreSQL ---
# docker-compose ichidagi "postgres" xizmati bilan mos:
POSTGRES_USER=afsona_dub
POSTGRES_PASSWORD=
POSTGRES_DB=afsona_dub
# ESLATMA: DATABASE_URL bu yerda YOZILMAYDI — docker-compose.yml ichida
# yuqoridagi POSTGRES_* qiymatlaridan avtomatik yig'iladi (${VAR} substitution
# faqat compose YAML darajasida ishlaydi, .env fayl ichida emas).

# --- Auth / ichki xavfsizlik ---
JWT_SECRET=
# generatsiya: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=
# generatsiya: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- API <-> Bot ---
# compose network ichida bot API'ga shu manzil orqali murojaat qiladi:
API_BASE_URL=http://api:8000

# --- Cloudflare R2 (personaj rasmlari + V1'dan boshlab original video) ---
# MUHIM (V1): video pleer/skrinshot ishlashi uchun R2 bucket'da CORS
# sozlangan bo'lishi shart — kamida GET (playback) va PUT (upload) metodlari,
# Access-Control-Allow-Origin: https://dub.afsonatv.uz (yoki haqiqiy domen).
# Aks holda brauzerda canvas.drawImage(videoElement) "tainted canvas" xatosi
# bilan ishlamay qoladi va presigned PUT upload CORS xatosi beradi.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- Domen (Caddy uchun) ---
DOMAIN=dub.example.com
[email protected]
